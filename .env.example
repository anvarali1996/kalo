# Copy to .env.local. Keep real credentials out of source control.
# Neon PostgreSQL pooled connection string (required for accounts and credits).
DATABASE_URL=

# Existing Open Food Facts contact email. Barcode scanning stays free.
OFF_CONTACT_EMAIL=

# Server-side only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Exact public origin, without a path. Use localhost for local development.
# On Vercel set this to your production/preview HTTPS origin for that environment.
APP_URL=http://localhost:3000
